{
  "name": "dsh-evidence-audit",
  "version": "0.1.0",
  "description": "Audit what the agent claims against what its own tools actually returned: per-sentence evidence coverage with the unsupported claims listed.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "audit",
    "grounding",
    "evidence",
    "verification",
    "trust"
  ],
  "license": "MIT",
  "author": "dsh-evidence-audit contributors",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/index.js",
    "dist/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "kit": {
    "id": "evidence-audit",
    "entry": {
      "client": "src/client.tsx",
      "host": "src/host.ts"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}
